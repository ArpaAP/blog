---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeBlock from "@/components/mdx/CodeBlock.astro";
import Callout from "@/components/mdx/Callout.astro";
import GiscusComments from "@/components/GiscusComments.astro";
import FootnotesHandler from "@/components/FootnotesHandler.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getArticleSlug } from "@/utils/article";

export async function getStaticPaths() {
  const posts = await getCollection("articles");
  const slugs = new Set<string>();

  return posts.map((post) => {
    const slug = getArticleSlug(post);
    if (slugs.has(slug)) {
      throw new Error(
        `Duplicate article slug "${slug}" detected in "${post.id}". Article filenames must be unique across all subdirectories.`
      );
    }
    slugs.add(slug);

    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<"articles">;
}

const { post } = Astro.props;
const slug = getArticleSlug(post);
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const ogImage = post.data.feature_image
  ? new URL(post.data.feature_image.src, Astro.site).href
  : undefined;
const tocHeadings = headings.filter((h) => h.slug !== "footnote-label");
const minDepth =
  tocHeadings.length > 0 ? Math.min(...tocHeadings.map((h) => h.depth)) : 1;
const readingTime = remarkPluginFrontmatter?.minutesRead;

const date = new Date(post.data.published_at).toLocaleDateString("ko-KR", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const articleUrl = new URL(`/articles/${slug}`, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  ...(post.data.excerpt && { description: post.data.excerpt }),
  datePublished: post.data.published_at.toISOString(),
  url: articleUrl,
  ...(ogImage && { image: ogImage }),
  author: {
    "@type": "Person",
    name: "Buyeon Hwang",
    url: "https://arpaap.dev",
  },
  publisher: {
    "@type": "Person",
    name: "Buyeon Hwang",
    url: "https://arpaap.dev",
  },
};
---

<BaseLayout
  title={`${post.data.title} - Devlog Alpha`}
  description={post.data.excerpt}
  transparentNavbar={!!post.data.feature_image}
  ogImage={ogImage}
  ogType="article"
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {
    post.data.feature_image ? (
      <div
        slot="hero"
        class="relative w-full h-[60vh] min-h-120 flex items-center justify-center overflow-hidden bg-gray-900 mb-12"
      >
        <div class="absolute inset-0 z-0">
          <Image
            src={post.data.feature_image}
            alt={post.data.feature_image_alt || post.data.title}
            class="w-full h-full object-cover opacity-60 blur-sm scale-105"
          />
          <div class="absolute inset-0 bg-black/40" />
        </div>

        <div class="relative z-10 w-full max-w-4xl mx-auto px-6 text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight drop-shadow-lg mt-8 mb-12 break-keep">
            {post.data.title}
          </h1>

          <div class="flex flex-col items-center justify-center gap-2 text-sm font-medium text-slate-200">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap items-center justify-center gap-2 mb-1">
                {post.data.tags.map((tag) => (
                  <span class="text-brand-300 text-base">#{tag}</span>
                ))}
              </div>
            )}
            <div class="flex items-center gap-3">
              <time datetime={post.data.published_at.toISOString()}>
                {date}
              </time>
              {readingTime && (
                <>
                  <span class="text-slate-400">&bull;</span>
                  <span class="text-slate-300">{readingTime}</span>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    ) : null
  }

  {
    tocHeadings.length > 0 && (
      <details id="mobile-toc" inert class="group pointer-events-none fixed inset-x-0 top-[69px] z-40 -translate-y-12 opacity-0 transition-[translate,opacity] duration-300 ease-out data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 motion-reduce:transition-none lg:hidden">
        <summary class="flex min-h-12 cursor-pointer list-none items-center gap-3 border-b border-gray-100 bg-background/90 px-6 text-sm backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-brand-600 dark:border-neutral-800 dark:bg-neutral-950/90 [&::-webkit-details-marker]:hidden">
          <svg id="mobile-toc-progress" role="progressbar" aria-label="글 읽기 진행도" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="size-5 shrink-0 -rotate-90 text-brand-600 dark:text-brand-300" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.2" stroke-width="2.5" />
            <circle id="mobile-toc-progress-ring" cx="12" cy="12" r="9" pathLength="100" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="0 100" />
          </svg>
          <span id="mobile-toc-current" class="min-w-0 flex-1 truncate font-medium text-slate-700 dark:text-neutral-200" aria-live="polite">{tocHeadings[0].text}</span>
          <svg aria-hidden="true" class="size-4 shrink-0 text-slate-500 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <nav aria-label="글 목차" class="absolute inset-x-0 top-12 max-h-[min(60vh,24rem)] overflow-y-auto border-b border-gray-200 bg-background/90 shadow-lg backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-950/90">
          <ul class="py-2">
            {tocHeadings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="mobile-toc-link block border-l-2 border-transparent py-2 pr-6 text-sm text-slate-600 hover:bg-brand-50 dark:text-neutral-300 dark:hover:bg-neutral-800"
                  data-slug={heading.slug}
                  style={{ paddingLeft: `${1.5 + (heading.depth - minDepth) * 0.75}rem` }}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )
  }

  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-12">
    <article class="w-full lg:w-[80%] min-w-0" data-pagefind-body>
      <div class="sr-only" aria-hidden="true">
        <span data-pagefind-meta="title">{post.data.title}</span>
        {
          post.data.tags.map((tag) => (
            <span data-pagefind-filter="tag">{tag}</span>
          ))
        }
      </div>
      <div class="mb-8">
        <a
          href="/articles"
          class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-brand-600 transition-colors"
        >
          &larr; 목록으로
        </a>
      </div>

      {
        !post.data.feature_image && (
          <header class="mb-12 border-b border-gray-200 dark:border-gray-700 pb-10">
            <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-slate-100 leading-tight mb-4 break-keep">
              {post.data.title}
            </h1>

            <div class="flex flex-col gap-2 text-sm text-slate-500">
              <div class="flex items-center gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-brand-600 dark:text-brand-300 font-medium text-base">
                    #{tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center gap-2">
                <time datetime={post.data.published_at.toISOString()}>
                  {date}
                </time>
                {readingTime && (
                  <>
                    <span>&bull;</span>
                    <span>{readingTime}</span>
                  </>
                )}
              </div>
            </div>
          </header>
        )
      }

      <div
        class="prose prose-h1:text-[32px] prose-h1:mt-12 prose-pre:my-0 prose-slate dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-a:text-brand-600 dark:prose-a:text-brand-300 max-w-none"
      >
        <Content components={{ pre: CodeBlock, Callout }} />
      </div>

      <FootnotesHandler />

      <GiscusComments />
    </article>

    <aside class="hidden lg:block w-[20%] shrink-0">
      <div class="sticky top-24 pt-4">
        <h2
          class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4"
        >
          On this page
        </h2>
        <nav
          class="max-h-[calc(100vh-10rem)] overflow-y-auto pr-2 scrollbar-hide"
        >
          <ul
            class="space-y-1 text-sm border-l-2 border-transparent hover:border-gray-200 dark:hover:border-neutral-800 transition-colors duration-200"
          >
            {
              tocHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link block py-1 -ml-0.5 text-slate-500 hover:text-slate-900 dark:text-neutral-500 dark:hover:text-neutral-300 transition-all duration-200 border-l-2 border-transparent hover:border-gray-300"
                    data-slug={heading.slug}
                    style={{
                      paddingLeft: `${1 + (heading.depth - minDepth) * 0.75}rem`,
                    }}
                  >
                    {heading.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>
  </div>

  <script>
    const ACTIVE_CLASSES = [
      "!text-brand-600",
      "dark:!text-brand-300",
      "!font-bold",
      "!border-brand-600",
      "dark:!border-brand-300",
    ];

    const mobileToc = document.querySelector<HTMLDetailsElement>("#mobile-toc");
    const currentLabel = document.querySelector<HTMLElement>("#mobile-toc-current");
    const progressIndicator = document.querySelector<SVGElement>("#mobile-toc-progress");
    const progressRing = document.querySelector<SVGCircleElement>("#mobile-toc-progress-ring");
    const article = document.querySelector<HTMLElement>("article[data-pagefind-body]");
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-link, .mobile-toc-link")];
    const headings = [...document.querySelectorAll<HTMLElement>(".prose h1[id], .prose h2[id], .prose h3[id], .prose h4[id]")]
      .filter((heading) => links.some((link) => link.dataset.slug === heading.id));
    let activeId: string | null = null;

    function setActive(id: string | null) {
      if (id === activeId) return;
      activeId = id;
      for (const link of links) {
        const active = link.dataset.slug === id;
        for (const className of ACTIVE_CLASSES) link.classList.toggle(className, active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
        if (active && window.innerWidth >= 1024 && link.classList.contains("toc-link")) {
          link.scrollIntoView({ block: "nearest" });
        }
      }
      if (currentLabel) {
        currentLabel.textContent = links.find((link) => link.classList.contains("mobile-toc-link") && link.dataset.slug === (id ?? headings[0]?.id))?.textContent?.trim() || "";
      }
    }

    function updateActive() {
      const offset = window.innerWidth < 1024 ? 145 : 110;
      let current: string | null = null;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > offset) break;
        current = heading.id;
      }
      setActive(current);
      if (!mobileToc || !headings.length || !article) return;
      const visible = current !== null;
      if (mobileToc.dataset.visible !== String(visible)) {
        mobileToc.dataset.visible = String(visible);
        mobileToc.inert = !visible;
      }
      if (!current) mobileToc.removeAttribute("open");
      const firstTop = headings[0].getBoundingClientRect().top;
      const articleBottom = article.getBoundingClientRect().bottom;
      const total = Math.max(1, articleBottom - firstTop - window.innerHeight + offset);
      const progress = Math.round(Math.max(0, Math.min(100, (offset - firstTop) / total * 100)));
      progressRing?.setAttribute("stroke-dasharray", `${progress} 100`);
      progressIndicator?.setAttribute("aria-valuenow", String(progress));
    }

    let scheduled = false;
    window.addEventListener("scroll", () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        updateActive();
        scheduled = false;
      });
    }, { passive: true });
    window.addEventListener("resize", updateActive);
    updateActive();

    for (const link of links) {
      link.addEventListener("click", (event) => {
        const target = headings.find((heading) => heading.id === link.dataset.slug);
        if (!target) return;
        event.preventDefault();
        mobileToc?.removeAttribute("open");
        setActive(target.id);
        const offset = window.innerWidth < 1024 ? 133 : 100;
        window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: "smooth" });
        history.pushState(null, "", `#${target.id}`);
      });
    }
  </script>
</BaseLayout>
